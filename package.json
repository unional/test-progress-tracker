{
	"name": "test-progress-tracker",
	"version": "2.0.8",
	"description": "Keep track of test progress over time",
	"homepage": "https://github.com/repobuddy/test-progress-tracker",
	"bugs": {
		"url": "https://github.com/repobuddy/test-progress-tracker/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/test-progress-tracker.git"
	},
	"license": "MIT",
	"main": "cjs/index.js",
	"typings": "cjs/index.d.ts",
	"files": [
		"cjs",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress,study,stories}.*"
	],
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "rimraf cjs coverage .turbo",
		"coverage": "vitest run --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "turbo run build typecheck coverage depcheck",
		"version": "changeset version",
		"watch": "vitest"
	},
	"dependencies": {
		"chokidar": "^3.6.0",
		"global-store": "^1.0.0-beta.21",
		"mkdirp": "^1.0.4",
		"unpartial": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/mkdirp": "^1.0.2",
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^4.0.18",
		"assertron": "^11.5.4",
		"delay": "^7.0.0",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"tsdown": "^0.23.0",
		"turbo": "^2.10.3",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18"
	},
	"packageManager": "pnpm@11.20.0"
}
